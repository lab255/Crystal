{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crystal",
  "version": "0.1.0",
  "identifier": "sh.crystal.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @crystal/server --filter @crystal/web --parallel dev",
    "beforeBuildCommand": "pnpm --filter @crystal/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Crystal",
        "width": 1500,
        "height": 950,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0c11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
