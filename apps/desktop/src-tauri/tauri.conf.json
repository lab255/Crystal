{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crystal",
  "version": "../package.json",
  "identifier": "sh.crystal.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @crystal/server --filter @crystal/web --parallel dev",
    "beforeBuildCommand": "pnpm --filter @crystal/web build && pnpm --filter @crystal/server build:sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "Crystal",
        "width": 1500,
        "height": 950,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0c11",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 11 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/crystal-server"],
    "resources": {
      "resources/sidecar": "sidecar"
    },
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/eliotlim/crystal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDRUIwMDEyNTBGQURENTUKUldSVjNmcFFFZ0RyL09TWlQ2b2kwMWE3OVFGY0JhMHNvSTFkSEpTdmJkbDhSbnNCbWYvRG5lVTMK"
    }
  }
}
