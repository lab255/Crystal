{
  "name": "@crystal/server",
  "version": "0.1.0",
  "description": "Crystal bridge server: workspace fs, git, .crystal persistence and Claude Code agent sessions over WebSocket",
  "type": "module",
  "bin": {
    "crystal-server": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts --root ../..",
    "start": "tsx src/index.ts",
    "build": "tsup",
    "build:sidecar": "node ../../scripts/build-sidecar.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crystal/core": "workspace:*",
    "@lydell/node-pty": "1.2.0-beta.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "ws": "^8.18.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.3.5"
  }
}
