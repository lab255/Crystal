{
  "name": "@crystal/sdk",
  "version": "0.1.0",
  "description": "Crystal SDK: embed the Crystal IDE (or any of its modes) in your own app",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
