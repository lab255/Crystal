    "@crystal/core": "workspace:*",
    "@crystal/editor": "workspace:*",
    "@crystal/orchestrator": "workspace:*",
    "@crystal/ui": "workspace:*",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.5.4"
  }
