{
  "name": "@crystal/sdk",
  "version": "0.1.0",
  "description": "Crystal SDK: embed the Crystal IDE (or any of its modes) in your own app",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && node ../../scripts/copy-css.mjs"
  },
  "dependencies": {
    "@crystal/architect": "workspace:*",
    "@crystal/client": "workspace:*",
    "@crystal/core": "workspace:*",
    "@crystal/editor": "workspace:*",
    "@crystal/orchestrator": "workspace:*",
    "@crystal/ui": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
