{
  "name": "@crystal/orchestrator",
  "version": "0.1.0",
  "description": "Crystal project management and agent orchestration: boards, tasks, live Claude Code runs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && node ../../scripts/copy-css.mjs"
  },
  "dependencies": {
    "@crystal/client": "workspace:*",
    "@crystal/core": "workspace:*",
    "@crystal/ui": "workspace:*",
    "@xyflow/react": "^12.8.0",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.5.4",
    "tsup": "^8.3.5"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
