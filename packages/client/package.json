{
  "name": "@crystal/client",
  "version": "0.1.0",
  "description": "Crystal client data layer: bridge transport, workspace and agent state, React hooks",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && node ../../scripts/copy-css.mjs"
  },
  "dependencies": {
    "@crystal/core": "workspace:*",
    "@crystal/ui": "workspace:*",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.469.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.1.0",
    "typescript": "^5.5.4",
    "tsup": "^8.3.5"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
