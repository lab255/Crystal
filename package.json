{
  "name": "crystal-monorepo",
  "private": true,
  "version": "0.15.0",
  "description": "Crystal — a multi-facet IDE for building systems and their software",
  "scripts": {
    "dev": "pnpm --parallel --filter @crystal/server --filter @crystal/web dev",
    "dev:web": "pnpm --filter @crystal/web dev",
    "dev:server": "pnpm --filter @crystal/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  }
}
